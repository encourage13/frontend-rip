{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "utility-services",
  "version": "0.1.0",
  "identifier": "ru.encourage.utility-services",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://localhost:3000/frontend-utility-services/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "vite build --config vite.tauri.config.ts"
    
  },
  "app": {
    "windows": [
      {
        "title": "utility-services",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
